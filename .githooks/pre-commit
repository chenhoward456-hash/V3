#!/bin/sh
# pre-commit hook：commit 前先跑 TypeScript 編譯
# 避免推到 main 才發現 TS error 導致 Vercel deploy fail

# 只看 staged TS/TSX 檔；沒改 TS 直接放行
staged_ts=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx)$' | head -1)
if [ -z "$staged_ts" ]; then
  exit 0
fi

echo "🔍 pre-commit: 跑 npx tsc --noEmit..."
output=$(npx tsc --noEmit 2>&1)
exit_code=$?

if [ $exit_code -ne 0 ]; then
  echo ""
  echo "❌ TypeScript 編譯失敗，commit 被擋住"
  echo ""
  echo "$output" | head -20
  echo ""
  echo "修好再 commit。要強制跳過：git commit --no-verify"
  exit 1
fi

echo "✅ tsc pass"
exit 0
